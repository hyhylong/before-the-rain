# Optional. The default demo works without any credentials.
PORT=4173
# SCENE_API_KEY=
# Include /v1 when your provider uses it.
# SCENE_API_BASE_URL=https://api.openai.com/v1
# SCENE_MODEL=gpt-4.1-mini
# SCENE_TIMEOUT_MS=20000

# DeepSeek text provider alternative (replace the text settings above).
# SCENE_API_KEY=
# SCENE_API_BASE_URL=https://api.deepseek.com
# SCENE_MODEL=deepseek-flash
# SCENE_THINKING=disabled
# Leave SCENE_THINKING unset for providers without this parameter.

# Optional transcription + speech provider, independent from the text model.
# SCENE_VOICE_API_KEY=
# SCENE_VOICE_BASE_URL=https://api.openai.com/v1
# SCENE_STT_MODEL=whisper-1
# SCENE_TTS_MODEL=tts-1
# SCENE_TTS_VOICE=nova

# Optional image creation with the current character reference.
# SCENE_IMAGE_API_KEY=
# SCENE_IMAGE_BASE_URL=https://api.openai.com/v1
# SCENE_IMAGE_MODEL=gpt-image-2

# A separately configured provider implementing asynchronous /videos jobs.
# All three settings are required. The retired OpenAI video endpoint is rejected.
# SCENE_VIDEO_API_KEY=
# SCENE_VIDEO_BASE_URL=https://your-compatible-provider.example/v1
# SCENE_VIDEO_MODEL=your-video-model
# SCENE_MEDIA_TIMEOUT_MS=180000
# SCENE_DATA_DIR=.data/sessions
